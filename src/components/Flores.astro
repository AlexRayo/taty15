---
// Ramo de rosas en acuarela (SVG). Se coloca en las esquinas de las secciones.
// Los degradados se definen una sola vez en <FloresDefs />.
interface Props {
  posicion?: 'arriba-izq' | 'arriba-der' | 'abajo-izq' | 'abajo-der';
  class?: string;
}
const { posicion = 'arriba-der', class: clase = 'w-40' } = Astro.props;

const lugar = {
  'arriba-izq': '-top-4 -left-6',
  'arriba-der': '-top-4 -right-6 -scale-x-100',
  'abajo-izq': '-bottom-4 -left-6 -scale-y-100',
  'abajo-der': '-bottom-4 -right-6 -scale-100',
}[posicion];
---

<svg
  class={`pointer-events-none absolute z-0 ${lugar} ${clase}`}
  viewBox="0 0 200 170"
  aria-hidden="true"
>
  <!-- tallos y hojas -->
  <g fill="url(#hoja)" stroke="#7f9474" stroke-width=".6" opacity=".9">
    <path d="M60 70c18-4 34 2 44 14-18 4-34-1-44-14Z" />
    <path d="M40 92c4 16-2 30-14 40-4-16 2-30 14-40Z" />
    <path d="M96 40c14-12 30-14 44-8-12 12-28 14-44 8Z" />
    <path d="M118 74c16 2 28 12 32 26-16-2-28-11-32-26Z" />
    <path d="M18 48c-2-14 6-26 18-32 2 14-6 26-18 32Z" />
    <path d="M76 112c10 10 12 24 8 36-10-10-12-24-8-36Z" />
  </g>
  <g fill="none" stroke="#8fa383" stroke-width="1.1" opacity=".8">
    <path d="M58 60c26 8 60 20 96 52" />
    <path d="M58 60c-8 24-18 46-34 66" />
    <path d="M58 60c18-14 46-24 82-28" />
  </g>

  <!-- rosa grande -->
  <g transform="translate(58 58)">
    <circle r="34" fill="url(#petalo)" />
    <path d="M-30 6C-32-16-12-32 8-30 24-28 34-14 30 4" fill="url(#petalo2)" opacity=".9" />
    <path d="M-20 14c-6-16 4-30 18-30 14 0 22 10 20 24" fill="url(#petalo)" />
    <path d="M-12 8c-2-10 4-16 12-16s14 6 12 14" fill="url(#petalo2)" />
    <path
      d="M-6 4c0-5 4-8 7-7 4 1 5 5 3 8-2 2-5 2-6 0"
      fill="none"
      stroke="#b56b7a"
      stroke-width="1.2"
      stroke-linecap="round"
    />
    <path
      d="M-26 20c10 10 30 12 44 4M-22-4c-6 8-6 18 0 26M24-10c6 8 6 20-2 28"
      fill="none"
      stroke="#d896a2"
      stroke-width="1"
      opacity=".7"
    />
  </g>

  <!-- rosa mediana -->
  <g transform="translate(118 100) rotate(-20)">
    <circle r="22" fill="url(#petalo3)" />
    <path d="M-18 4c-2-14 10-22 22-20 10 2 16 10 14 20" fill="url(#petalo)" opacity=".9" />
    <path d="M-10 6c-2-8 4-14 10-14s10 6 8 12" fill="url(#petalo3)" />
    <path d="M-4 3c0-3 3-5 5-4s3 4 1 5" fill="none" stroke="#b77a68" stroke-width="1" stroke-linecap="round" />
  </g>

  <!-- capullos -->
  <g>
    <ellipse cx="150" cy="34" rx="8" ry="11" transform="rotate(30 150 34)" fill="url(#petalo2)" />
    <path d="M144 42c4 4 10 2 12-4" fill="#9fb293" />
    <ellipse cx="26" cy="128" rx="7" ry="10" transform="rotate(-25 26 128)" fill="url(#petalo3)" />
    <path d="M22 136c4 3 9 1 10-4" fill="#9fb293" />
  </g>

  <!-- flores pequeñas blancas -->
  <g fill="#fffdfb" stroke="#e8c9cf" stroke-width=".6">
    <g transform="translate(96 22)">
      <circle cx="0" cy="-5" r="4" /><circle cx="5" cy="0" r="4" /><circle cx="0" cy="5" r="4" /><circle
        cx="-5"
        cy="0"
        r="4"></circle>
      <circle r="2.2" fill="#ead18d" stroke="none" />
    </g>
    <g transform="translate(152 128) scale(.8)">
      <circle cx="0" cy="-5" r="4" /><circle cx="5" cy="0" r="4" /><circle cx="0" cy="5" r="4" /><circle
        cx="-5"
        cy="0"
        r="4"></circle>
      <circle r="2.2" fill="#ead18d" stroke="none" />
    </g>
  </g>

  <!-- destellos dorados -->
  <g fill="#c9a14a">
    <circle cx="170" cy="70" r="1.8" /><circle cx="180" cy="86" r="1.2" /><circle cx="110" cy="140" r="1.5" />
    <circle cx="14" cy="80" r="1.3" />
  </g>
</svg>
